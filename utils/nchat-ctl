"""CLI client for nchat agent control socket (newline-delimited JSON)."""

from __future__ import annotations

import argparse
import json
import os
import socket
import sys
from pathlib import Path


def confdir_sock(confdir: str) -> Path:
    return Path(confdir).expanduser().resolve() / "control.sock"


def call(sock_path: Path, request: dict, timeout: float = 35.0) -> dict:
    if not sock_path.is_socket() and not sock_path.exists():
        print(
            f"error: control socket missing ({sock_path}). "
            "TUI is not running for that confdir (or build lacks agent control).",
            file=sys.stderr,
        )
        sys.exit(2)

    line = json.dumps(request, ensure_ascii=False, separators=(",", ":")) + "\n"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect(str(sock_path))
            s.sendall(line.encode("utf-8"))
            buf = b""
            while b"\n" not in buf:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
    except (FileNotFoundError, ConnectionRefusedError, OSError) as exc:
        print(
            f"error: cannot connect to {sock_path}: {exc}. "
            "TUI is not running for that confdir.",
            file=sys.stderr,
        )
        sys.exit(2)

    text = buf.decode("utf-8", errors="replace").strip()
    if not text:
        print("error: empty response from nchat", file=sys.stderr)
        sys.exit(1)
    try:
        return json.loads(text.splitlines()[0])
    except json.JSONDecodeError as exc:
        print(f"error: invalid JSON response: {exc}", file=sys.stderr)
        sys.exit(1)


def main() -> int:
    parser = argparse.ArgumentParser(description="nchat agent control client")
    parser.add_argument(
        "--confdir",
        required=True,
        help="nchat confdir (same as nchat -d); socket is CONFDIR/control.sock",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("chats", help="list chats known to the running TUI")

    p_hist = sub.add_parser("history", help="message history for a chat")
    p_hist.add_argument("--chat", required=True, help="chat id")
    p_hist.add_argument("--limit", type=int, default=30, help="1..100 (default 30)")

    p_send = sub.add_parser("send", help="send a text message")
    p_send.add_argument("--chat", required=True)
    p_send.add_argument("--text", required=True)
    p_send.add_argument("--reply-to", default=None, dest="reply_to")

    p_file = sub.add_parser("send-file", help="send a regular file")
    p_file.add_argument("--chat", required=True)
    p_file.add_argument("--path", required=True)

    args = parser.parse_args()
    sock = confdir_sock(args.confdir)

    req_id = "1"
    if args.cmd == "chats":
        req = {"id": req_id, "method": "chats", "params": {}}
    elif args.cmd == "history":
        params = {"chat": args.chat, "limit": args.limit}
        req = {"id": req_id, "method": "history", "params": params}
    elif args.cmd == "send":
        params = {"chat": args.chat, "text": args.text}
        if args.reply_to:
            params["replyTo"] = args.reply_to
        req = {"id": req_id, "method": "send", "params": params}
    elif args.cmd == "send-file":
        req = {
            "id": req_id,
            "method": "send_file",
            "params": {"chat": args.chat, "path": args.path},
        }
    else:
        parser.error(f"unknown command {args.cmd}")
        return 1

    resp = call(sock, req)
    if not resp.get("ok"):
        err = resp.get("error") or "unknown error"
        print(err, file=sys.stderr)
        return 1

    result = resp.get("result")
    print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
